{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pontilha",
  "version": "0.1.0",
  "identifier": "app.pontilha.editor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pontilha",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#29282f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Graphics",
    "shortDescription": "Editor de pixel art",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
