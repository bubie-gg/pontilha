{
  "name": "New Year Badge",
  "description": "Magenta firework burst with a white core, gold embers and confetti, no background. Study: NYR00, ITA65, UK739. 32 × 32; export at scale 4.",
  "steps": [
    { "id": "doc.new", "params": { "width": 32, "height": 32, "name": "badge-new-year" } },
    { "id": "palette.set", "params": { "colors": ["#8a2340", "#c93c4a", "#f0715e", "#ff8fb0", "#ffd0e0", "#f7f4fa", "#f6b847", "#ffe6a0", "#4fb0f0", "#7dc25b", "#c98be0"] } },
    { "id": "layer.setProps", "params": { "name": "burst" } },
    { "id": "draw.burst", "params": { "cx": 15.5, "cy": 15.5, "outer": 14, "inner": 3, "rays": 32, "rotation": -90, "colors": ["#ffd0e0", "#ff8fb0", "#c93c4a", "#c93c4a", "#8a2340"], "dash": [3, 1], "alternate": 0.75 } },
    { "id": "draw.burst", "params": { "cx": 15.5, "cy": 15.5, "outer": 11, "inner": 3, "rays": 32, "rotation": -84.4, "colors": ["#ffd0e0", "#ff8fb0", "#f0715e", "#c93c4a"], "dash": [2, 2], "alternate": 0.7 } },
    { "id": "draw.burst", "params": { "cx": 15.5, "cy": 15.5, "outer": 15, "inner": 13, "rays": 16, "rotation": -90, "color": "#8a2340", "dash": [1, 1] } },

    { "id": "layer.new", "params": { "name": "core" } },
    { "id": "draw.ellipse", "params": { "x": 12, "y": 12, "w": 7, "h": 7, "color": "#ffd0e0", "filled": true } },
    { "id": "draw.ellipse", "params": { "x": 13, "y": 13, "w": 5, "h": 5, "color": "#f7f4fa", "filled": true } },
    { "id": "draw.burst", "params": { "cx": 15.5, "cy": 15.5, "outer": 7, "inner": 2, "rays": 8, "rotation": -90, "color": "#f7f4fa" } },
    { "id": "draw.burst", "params": { "cx": 15.5, "cy": 15.5, "outer": 5, "inner": 3, "rays": 8, "rotation": -67.5, "color": "#ffd0e0" } },

    { "id": "layer.new", "params": { "name": "embers" } },
    { "id": "draw.pattern", "params": { "x": 2, "y": 3, "legend": { "a": "#f6b847", "b": "#ffe6a0" }, "rows": [".a.", "aba", ".a."] } },
    { "id": "draw.pattern", "params": { "x": 26, "y": 4, "legend": { "a": "#f6b847", "b": "#ffe6a0" }, "rows": [".a.", "aba", ".a."] } },
    { "id": "draw.pattern", "params": { "x": 25, "y": 25, "legend": { "a": "#f6b847", "b": "#ffe6a0" }, "rows": [".a.", "aba", ".a."] } },
    { "id": "draw.pattern", "params": { "x": 3, "y": 24, "legend": { "a": "#f6b847", "b": "#ffe6a0" }, "rows": [".a.", "aba", ".a."] } },
    { "id": "draw.pixels", "params": { "color": "#f6b847", "pixels": [[15, 0], [16, 0], [0, 15], [0, 16], [31, 15], [31, 16], [15, 31], [16, 31], [8, 1], [23, 1], [30, 8], [30, 23], [1, 8], [1, 23], [8, 30], [23, 30]] } },
    { "id": "draw.pixels", "params": { "color": "#ffe6a0", "pixels": [[22, 8], [9, 8], [9, 22], [22, 22], [5, 15], [26, 15], [15, 5], [15, 26]] } },
    { "id": "draw.pixels", "params": { "pixels": [[1, 2, "#4fb0f0"], [29, 1, "#7dc25b"], [2, 29, "#c98be0"], [30, 29, "#4fb0f0"], [12, 2, "#c98be0"], [19, 29, "#7dc25b"], [2, 12, "#7dc25b"], [29, 19, "#c98be0"]] } }
  ]
}
