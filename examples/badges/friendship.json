{
  "name": "Friendship Badge",
  "description": "Heart split into two tones (red and blue) on a gold medallion, with a shine. Study: DE429, SG5, RSH21. 32 × 32; export at scale 4.",
  "steps": [
    { "id": "doc.new", "params": { "width": 32, "height": 32, "name": "badge-friendship" } },
    { "id": "palette.set", "params": { "colors": ["#16141c", "#db7b2a", "#f6b847", "#ffe6a0", "#8a2340", "#c93c4a", "#f0715e", "#1f3e8c", "#2f6fd0", "#4fb0f0", "#f7f4fa"] } },
    { "id": "layer.setProps", "params": { "name": "medallion" } },
    { "id": "draw.ellipse", "params": { "x": 2, "y": 2, "w": 28, "h": 28, "color": "#db7b2a", "filled": true } },
    { "id": "draw.ellipse", "params": { "x": 1, "y": 1, "w": 28, "h": 28, "color": "#ffe6a0", "filled": true, "onlyOn": "#db7b2a" } },
    { "id": "draw.ellipse", "params": { "x": 3, "y": 3, "w": 28, "h": 28, "color": "#f6b847", "filled": true, "onlyOn": "#ffe6a0" } },
    { "id": "draw.ellipse", "params": { "x": 5, "y": 5, "w": 22, "h": 22, "color": "#db7b2a" } },
    { "id": "effect.outline", "params": { "color": "#16141c" } },

    { "id": "layer.new", "params": { "name": "heart" } },
    { "id": "draw.pattern", "params": { "x": 8, "y": 9, "legend": { "r": "#c93c4a", "R": "#8a2340", "p": "#f0715e", "b": "#2f6fd0", "B": "#1f3e8c", "c": "#4fb0f0", "w": "#f7f4fa" }, "rows": [
      "..rrrr....bbbb..",
      ".rprrrr..bbbbbb.",
      "rpwrrrrrbbbbbbcb",
      "rprrrrrrbbbbbbcB",
      "rrrrrrrrbbbbbbBB",
      "rrrrrrrrbbbbbbBB",
      ".rrrrrrrbbbbbBB.",
      ".rrrrrrrbbbbbBB.",
      "..rrrrrrbbbbBB..",
      "...rrrrrbbbBB...",
      "....rrrrbbBB....",
      ".....rrrbBB.....",
      "......rrBB......",
      ".......rB......."
    ] } },
    { "id": "effect.outline", "params": { "color": "#16141c" } },

    { "id": "layer.new", "params": { "name": "shine" } },
    { "id": "draw.pattern", "params": { "x": 22, "y": 4, "legend": { "a": "#ffe6a0", "b": "#f7f4fa" }, "rows": [".a.", "aba", ".a."] } },
    { "id": "draw.pixels", "params": { "pixels": [[6, 7, "#ffe6a0"], [25, 24, "#ffe6a0"]] } }
  ]
}
